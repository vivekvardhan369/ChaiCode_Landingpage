{
    "compilerOptions": {
      "baseUrl": ".",
      "paths": {
        "react": ["node_modules/react"],
        "react-dom": ["node_modules/react-dom"],
        "scheduler": ["node_modules/scheduler"]
      },
      "jsx": "react",
      "target": "es2020",
      "module": "esnext",
      "moduleResolution": "node",
      "esModuleInterop": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "build", "dist"]
  }